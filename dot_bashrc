# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# Line editors and interactive hooks must not run in scripts or CI shells.
[[ $- == *i* ]] || return

# Atuin + ble.sh is the default Bash stack. The optional inshellisense
# installer writes a machine-local alternative without modifying dotfiles.
mydotfiles_history_backend="atuin"
if [ -r "$HOME/.config/shell/history-backend" ]; then
    IFS= read -r mydotfiles_history_backend < "$HOME/.config/shell/history-backend"
fi

# Load ble.sh before prompt and Atuin hooks, then attach it at the very end.
if [[ $- == *i* ]] &&
    [ "$mydotfiles_history_backend" = "atuin" ] &&
    [ -r "$HOME/.local/share/blesh/ble.sh" ]; then
    source -- "$HOME/.local/share/blesh/ble.sh" --attach=none
fi

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc

if [ -r "$HOME/.config/shell/lfcd.sh" ]; then
    . "$HOME/.config/shell/lfcd.sh"
fi

# Oh My Posh prompt - same atomic theme used by the Windows PowerShell profile.
if command -v oh-my-posh >/dev/null 2>&1; then
    eval "$(oh-my-posh init bash --config atomic)"
fi

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Codex installer
[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"

# opencode
[ -d "$HOME/.opencode/bin" ] && export PATH="$HOME/.opencode/bin:$PATH"

# Machine-local secrets and overrides; never tracked by chezmoi.
[ -f "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"

if [ "$mydotfiles_history_backend" = "inshellisense" ]; then
    [ -f "$HOME/.inshellisense/init/bash/init.sh" ] && . "$HOME/.inshellisense/init/bash/init.sh"
else
    [ -d "$HOME/.atuin/bin" ] && PATH="$HOME/.atuin/bin:$PATH"
    if command -v atuin >/dev/null 2>&1; then
        eval "$(ATUIN_NO_BUILTIN_PREEXEC=1 atuin init bash)"
    fi
    [[ ! ${BLE_VERSION-} ]] || ble-attach
fi
unset mydotfiles_history_backend
