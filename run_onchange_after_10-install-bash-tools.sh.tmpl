{{ if and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) -}}
#!/usr/bin/env bash
# Install the default ble.sh + Atuin stack on existing WSL environments.

set -euo pipefail

bash "{{ .chezmoi.sourceDir }}/scripts/install-blesh.sh"
bash "{{ .chezmoi.sourceDir }}/scripts/install-atuin.sh"
{{ else -}}
#!/bin/sh
# Bash tool auto-installation is limited to WSL.
exit 0
{{ end -}}
