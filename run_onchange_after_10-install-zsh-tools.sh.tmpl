{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/usr/bin/env bash
# Remove the legacy Bash line editor and install the Zsh + Atuin stack.

set -euo pipefail

if [ -z "${HOME:-}" ] || [ "$HOME" = "/" ]; then
    echo "Refusing to clean legacy shell files with an unsafe HOME." >&2
    exit 1
fi

for legacy_path in \
    "$HOME/.local/share/blesh" \
    "$HOME/.cache/blesh" \
    "$HOME/.local/state/blesh" \
    "$HOME/.config/blesh"; do
    if [ -e "$legacy_path" ] || [ -L "$legacy_path" ]; then
        echo "==> Removing legacy shell files: $legacy_path"
        rm -rf -- "$legacy_path"
    fi
done
unset legacy_path

bash "{{ .chezmoi.sourceDir }}/scripts/install-zsh-plugins.sh"
bash "{{ .chezmoi.sourceDir }}/scripts/install-atuin.sh"

{{ if eq .chezmoi.os "linux" -}}
zsh_bin="$(command -v zsh)"
current_shell="$(getent passwd "$(id -un)" | cut -d: -f7)"
if [ "$current_shell" != "$zsh_bin" ]; then
    echo "==> Setting the default shell to $zsh_bin..."
    if [ "$(id -u)" -eq 0 ]; then
        chsh -s "$zsh_bin" "$(id -un)"
    elif command -v sudo >/dev/null 2>&1; then
        sudo chsh -s "$zsh_bin" "$(id -un)"
    else
        chsh -s "$zsh_bin"
    fi
fi
{{ end -}}

echo "==> Open a new terminal or run 'exec zsh' to discard loaded Bash state."
{{ else -}}
#!/bin/sh
# Windows is handled by the PowerShell bootstrap.
exit 0
{{ end -}}
