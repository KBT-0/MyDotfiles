# .zshrc

if [ -d "$HOME/.local/bin" ]; then
    path=("$HOME/.local/bin" $path)
fi

if [ -d "$HOME/bin" ]; then
    path=("$HOME/bin" $path)
fi

# Homebrew defaults on Apple Silicon and Intel macOS.
if [ -d /opt/homebrew/bin ]; then
    path=(/opt/homebrew/bin $path)
fi

if [ -d /usr/local/bin ]; then
    path=(/usr/local/bin $path)
fi

export PATH

if [ -r "$HOME/.config/shell/lfcd.sh" ]; then
    . "$HOME/.config/shell/lfcd.sh"
fi

# Oh My Posh prompt - same atomic theme used by the Windows PowerShell profile.
if command -v oh-my-posh >/dev/null 2>&1; then
    eval "$(oh-my-posh init zsh --config atomic)"
fi

# Larger history file + share between sessions
HISTSIZE=50000
SAVEHIST=50000
HISTFILE=~/.zsh_history
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS

# Atuin + zsh-autosuggestions is the default on Linux and macOS.
# The optional inshellisense installer writes a machine-local alternative.
mydotfiles_history_backend="atuin"
if [[ -r "$HOME/.config/shell/history-backend" ]]; then
    IFS= read -r mydotfiles_history_backend < "$HOME/.config/shell/history-backend"
fi

if [[ "$mydotfiles_history_backend" == "inshellisense" ]]; then
    unset mydotfiles_history_backend
    [[ -f "$HOME/.inshellisense/init/zsh/init.zsh" ]] && source "$HOME/.inshellisense/init/zsh/init.zsh"
else
    [[ -d "$HOME/.atuin/bin" ]] && path=("$HOME/.atuin/bin" $path)

    # Fast, history-only grey suggestions. Right Arrow or End accepts them.
    ZSH_AUTOSUGGEST_STRATEGY=(history)
    ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
    if [[ -r "$HOME/.local/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
        source "$HOME/.local/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
        bindkey '^[[Z' autosuggest-accept  # Shift+Tab accepts the full suggestion.
    fi

    # Atuin owns Ctrl-R and Up Arrow for its richer history search.
    if command -v atuin >/dev/null 2>&1; then
        eval "$(atuin init zsh)"
    fi

    # Atuin prepends its own autosuggestion strategy; keep grey suggestions
    # strictly local and history-only as configured above.
    ZSH_AUTOSUGGEST_STRATEGY=(history)

    unset mydotfiles_history_backend

    # Must remain the final sourced plugin so it can wrap every ZLE widget.
    if [[ -r "$HOME/.local/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
        source "$HOME/.local/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
    fi
fi
