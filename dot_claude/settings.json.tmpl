{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
{{ if ne .chezmoi.os "windows" }}
  "statusLine": {
    "type": "command",
    "command": "bash {{ .chezmoi.homeDir }}/.claude/statusline.sh",
    "refreshInterval": 3
  },
{{ end }}
  "enabledPlugins": {
    "caveman@caveman": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "language": "Turkish",
  "effortLevel": "low",
  "tui": "fullscreen",
  "theme": "dark",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false
}
