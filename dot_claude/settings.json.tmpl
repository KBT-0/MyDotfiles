{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
{{- if eq .chezmoi.os "windows" }}
    "command": "\"C:/Program Files/Git/bin/bash.exe\" {{ .chezmoi.homeDir }}/.claude/statusline.sh",
{{- else }}
    "command": "bash {{ .chezmoi.homeDir }}/.claude/statusline.sh",
{{- end }}
    "refreshInterval": 3
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "language": "Turkish",
  "effortLevel": "low",
  "tui": "fullscreen",
  "theme": "dark",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false
}
